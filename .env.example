# VRGC Live Environment Variables Template
# Copy this file to .env.local and add your real keys.
# DO NOT COMMIT .env.local TO GIT.

# vrgc-form Firebase (Auth, Member Reg, Passholders)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=vrgc-form.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=vrgc-form
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=vrgc-form.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# vrgc-main Firebase (Primary DB & Assets)
NEXT_PUBLIC_MAIN_FIREBASE_API_KEY=
NEXT_PUBLIC_MAIN_FIREBASE_AUTH_DOMAIN=vrgc-main.firebaseapp.com
NEXT_PUBLIC_MAIN_FIREBASE_PROJECT_ID=vrgc-main
NEXT_PUBLIC_MAIN_FIREBASE_STORAGE_BUCKET=vrgc-main.firebasestorage.app
NEXT_PUBLIC_MAIN_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_MAIN_FIREBASE_APP_ID=
NEXT_PUBLIC_MAIN_FIREBASE_MEASUREMENT_ID=

# Salt for hashing member avatars (keep private)
NEXT_PUBLIC_IMAGE_SECRET_SALT=
